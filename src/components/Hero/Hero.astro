---
import ImageContensis from '~/components/ImageContensis/ImageContensis.astro';
import { Badge } from '~/components/ui/badge';
import type { MappedImage } from '~/lib/contensisImage';

interface Props {
  title: string;
  image?: MappedImage | null;
  tags?: string[];
}

const { title, image, tags = [] } = Astro.props;
// The section is a fixed 12/5 box, hence the 1920x800 fallback size for images without one.
---

<section
  class="relative isolate flex min-h-64 items-end overflow-hidden rounded-lg bg-muted sm:aspect-[12/5] sm:min-h-0"
>
  <ImageContensis
    class="absolute inset-0 -z-10 size-full object-cover"
    image={image}
    sizes="hero"
    priority
    fallbackSize={{ width: 1920, height: 800 }}
  />
  <div
    class:list={[
      'w-full p-6 sm:p-10',
      image && 'bg-linear-to-t from-black/70 to-transparent text-white',
    ]}
  >
    {
      tags.length > 0 && (
        <ul class="mb-4 flex flex-wrap gap-2" aria-label="Tags">
          {tags.map(tag => (
            <li>
              <Badge variant="secondary">{tag}</Badge>
            </li>
          ))}
        </ul>
      )
    }
    <h1 class="max-w-3xl text-3xl font-semibold tracking-tight sm:text-5xl">
      {title}
    </h1>
  </div>
</section>
