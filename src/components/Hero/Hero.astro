---
import { Image } from 'astro:assets';
import { Badge } from '~/components/ui/badge';
import type { MappedImage } from '~/lib/contensisImage';

interface Props {
  title: string;
  image?: MappedImage | null;
  tags?: string[];
}

const { title, image, tags = [] } = Astro.props;

// `sizes` mirrors the page layout: the templates wrap the Hero in `main.p-8` (2rem each
// side) and `div.max-w-5xl` (64rem = 1024px), so it is 100vw - 4rem until the viewport
// reaches 1024px + 4rem = 1088px, then fixed at 1024px. Update both together with the
// layout (LandingPage, ContentArticle, FormPage).
const heroSizes = '(min-width: 1088px) 1024px, calc(100vw - 4rem)';
// Dimensions are missing only when mapImage could not resolve them (it already warns in dev).
const [width, height] =
  image?.width && image?.height ? [image.width, image.height] : [1920, 800];
---

<section
  class="relative isolate flex min-h-64 items-end overflow-hidden rounded-lg bg-muted sm:aspect-[12/5] sm:min-h-0"
>
  {
    image && (
      <Image
        class="absolute inset-0 -z-10 size-full object-cover"
        src={image.src}
        alt={image.alt}
        width={width}
        height={height}
        sizes={heroSizes}
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    )
  }
  <div
    class:list={[
      'w-full p-6 sm:p-10',
      image && 'bg-linear-to-t from-black/70 to-transparent text-white',
    ]}
  >
    {
      tags.length > 0 && (
        <ul class="mb-4 flex flex-wrap gap-2" aria-label="Tags">
          {tags.map(tag => (
            <li>
              <Badge variant="secondary">{tag}</Badge>
            </li>
          ))}
        </ul>
      )
    }
    <h1 class="max-w-3xl text-3xl font-semibold tracking-tight sm:text-5xl">
      {title}
    </h1>
  </div>
</section>
