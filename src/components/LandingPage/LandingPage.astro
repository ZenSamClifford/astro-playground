---
import type { ContentTypePageProps } from '@contensis/content-resolver';
import Hero from '~/components/Hero/Hero.astro';
import type { LandingComposerItem } from '~/contensis.mappers';
import type { MappedImage } from '~/lib/contensisImage';
import { createAstroCanvasRenderer } from '~/lib/canvasRendererAstro';
import Layout from '~/layouts/Layout.astro';

interface LandingPageProps {
  mappedTitle: string;
  image: MappedImage | null;
  composer: LandingComposerItem[];
}

interface Props extends ContentTypePageProps<LandingPageProps> {}

const { entry, mappedEntry, node } = Astro.props;

// `sizes` mirrors the layout: `main.p-8` (2rem each side) around a column that is
// `max-w-[37em]` of a `.typeset-article` element, whose font-size is 18px below 768px
// (--typeset-size 16px x 1.125) and 16px from 768px. So the column is 666px at most below
// 768px (it reaches that at a 730px viewport, 730 - 64 = 666), and 592px from 768px (the
// lg grid track is also 37em of 16px = 592px). Update together with the layout.
const canvasSizes =
  '(min-width: 768px) 592px, (min-width: 730px) 666px, calc(100vw - 4rem)';
const renderCanvas = createAstroCanvasRenderer({ sizes: canvasSizes });
---

<Layout pageTitle={entry.entryTitle || node.displayName || 'Landing'}>
  <main class="p-8">
    <div class="mb-6 max-w-5xl">
      <Hero title={mappedEntry.mappedTitle} image={mappedEntry.image} />
    </div>
    {
      mappedEntry.composer.length > 0 && (
        <div class="canvas-content typeset typeset-article max-w-[37em]">
          {mappedEntry.composer.map(item => {
            switch (item.type) {
              case 'text':
                return item.value?.length ? (
                  <Fragment set:html={renderCanvas({ data: item.value })} />
                ) : null;
              case 'quote':
                return item.value?.text ? (
                  <figure>
                    <blockquote>
                      <p>{item.value.text}</p>
                    </blockquote>
                    {item.value.source && (
                      <figcaption>{item.value.source}</figcaption>
                    )}
                  </figure>
                ) : null;
              default:
                // Composer types added to the content type later render nothing
                return null;
            }
          })}
        </div>
      )
    }
  </main>
</Layout>
