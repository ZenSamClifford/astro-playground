---
import type { Block } from '@contensis/canvas-html';
import type { ContentTypePageProps } from '@contensis/content-resolver';
import Hero from '~/components/Hero/Hero.astro';
import RelatedPages from '~/components/RelatedPages/RelatedPages.astro';
import type { MappedImage } from '~/lib/contensisImage';
import { createAstroCanvasRenderer } from '~/lib/canvasRendererAstro';
import Layout from '~/layouts/Layout.astro';

interface ContentArticleProps {
  mappedTitle: string;
  image: MappedImage | null;
  canvas: Block[];
  categories: string[];
}

interface Props extends ContentTypePageProps<ContentArticleProps> {}

const { entry, mappedEntry, node, resolver } = Astro.props;

// `sizes` mirrors the layout: `main.p-8` (2rem each side) around a column that is
// `max-w-[37em]` of a `.typeset-article` element, whose font-size is 18px below 768px
// (--typeset-size 16px x 1.125) and 16px from 768px. So the column is 666px at most below
// 768px (it reaches that at a 730px viewport, 730 - 64 = 666), and 592px from 768px (the
// lg grid track is also 37em of 16px = 592px). Update together with the layout.
const canvasSizes =
  '(min-width: 768px) 592px, (min-width: 730px) 666px, calc(100vw - 4rem)';
const renderCanvas = createAstroCanvasRenderer({ sizes: canvasSizes });
const canvasHtml = mappedEntry.canvas?.length
  ? renderCanvas({ data: mappedEntry.canvas })
  : '';
---

<Layout pageTitle={entry.entryTitle || node.displayName || 'Content'}>
  <main class="p-8">
    <div class="mb-6 max-w-5xl">
      <Hero
        title={mappedEntry.mappedTitle}
        image={mappedEntry.image}
        tags={mappedEntry.categories}
      />
    </div>
    <div class="grid gap-8 lg:grid-cols-[37em_20rem]">
      {
        canvasHtml && (
          <div
            class="canvas-content typeset typeset-article max-w-[37em]"
            set:html={canvasHtml}
          />
        )
      }
      <RelatedPages
        resolver={resolver}
        entryId={entry.sys.id}
        categories={mappedEntry.categories ?? []}
      />
    </div>
  </main>
</Layout>
