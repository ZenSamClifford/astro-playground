---
import { languageLabel } from '~/i18n/language';
import type { TranslationLink } from '~/i18n/translations';

interface Props {
  current: string;
  links: TranslationLink[];
  label: string;
}

const { current, links, label } = Astro.props;
// Keep the search and preview settings when switching language. Anything else is
// dropped: `entryId` and `nodeId` would resolve the same page again, and `page`
// may not exist in the other language's results.
const kept = new URLSearchParams();
for (const name of ['term', 'type', 'versionStatus']) {
  const value = Astro.url.searchParams.get(name);
  if (value) kept.set(name, value);
}
const search = kept.size ? `?${kept}` : '';
---

{
  links.length > 0 && (
    <nav aria-label={label}>
      <ul class="flex items-center gap-3 text-sm">
        {links.map(link => (
          <li>
            {link.href ? (
              <a
                href={link.href + search}
                lang={link.language}
                hreflang={link.language}
                aria-current={link.language === current ? 'true' : undefined}
                class="underline-offset-4 hover:underline aria-[current=true]:font-semibold"
              >
                {languageLabel(link.language)}
              </a>
            ) : (
              <span lang={link.language} class="text-muted-foreground">
                {languageLabel(link.language)}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}
